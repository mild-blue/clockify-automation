# Copy to .env and fill in. The .env file is gitignored.

# Required: Clockify Profile → Preferences → API
CLOCKIFY_API_KEY=

# Optional: only set if you have multiple workspaces and the default isn't right.
# CLOCKIFY_WORKSPACE_ID=

# Optional: IANA timezone, drives "what counts as today".
# TIMEZONE=Europe/Prague

# Optional: used to spot gaps in your day.
# WORKDAY_START=09:00
# WORKDAY_END=17:00
